# Copy to .env for Compose; export Python variables in your shell as documented.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CLIOVA_API_URL=http://localhost:8000
CLIOVA_ENV=development
# Local development credentials only. Bind PostgreSQL to loopback.
CLIOVA_POSTGRES_PORT=5434
CLIOVA_DATABASE_URL=postgresql://cliova:cliova@localhost:5434/cliova
CLIOVA_TEST_DATABASE_URL=postgresql://cliova:cliova@localhost:5434/cliova
